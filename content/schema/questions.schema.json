{
  "$ref": "#/definitions/questions",
  "definitions": {
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^q-[1-5]\\.[1-9]-\\d{3}$"
          },
          "objective": {
            "type": "string",
            "pattern": "^[1-5]\\.[1-9]$"
          },
          "type": {
            "type": "string",
            "enum": [
              "single",
              "multi"
            ],
            "default": "single"
          },
          "difficulty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "default": 2
          },
          "stem": {
            "type": "string",
            "minLength": 20
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "why": {
                  "type": "string",
                  "minLength": 10
                }
              },
              "required": [
                "text",
                "why"
              ],
              "additionalProperties": false
            },
            "minItems": 4,
            "maxItems": 6
          },
          "answer": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 1
          },
          "explanation": {
            "type": "string",
            "minLength": 20
          },
          "industryVsComptia": {
            "type": [
              "string",
              "null"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "reviewed"
            ],
            "default": "reviewed"
          }
        },
        "required": [
          "id",
          "objective",
          "stem",
          "options",
          "answer",
          "explanation"
        ],
        "additionalProperties": false
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
