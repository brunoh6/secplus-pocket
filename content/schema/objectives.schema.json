{
  "$ref": "#/definitions/objectives",
  "definitions": {
    "objectives": {
      "type": "object",
      "properties": {
        "exam": {
          "type": "string",
          "const": "SY0-701"
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "name": {
                "type": "string"
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 1
              },
              "objectives": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[1-5]\\.[1-9]$"
                    },
                    "title": {
                      "type": "string",
                      "minLength": 5
                    }
                  },
                  "required": [
                    "id",
                    "title"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "name",
              "weight",
              "objectives"
            ],
            "additionalProperties": false
          },
          "minItems": 5,
          "maxItems": 5
        }
      },
      "required": [
        "exam",
        "domains"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
